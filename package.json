{
  "name": "@sandsoftwaresolutions/duration",
  "version": "0.1.1",
  "description": "Read and show durations: 1h30m, 90 min, 2 uur, ISO 8601. Refuses what it cannot read.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "duration",
    "time",
    "iso8601",
    "parse"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-duration.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-duration/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-duration#readme",
  "publishConfig": {
    "access": "public"
  }
}
